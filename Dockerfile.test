# syntax=docker/dockerfile:1.7
# Test image for moeka. Layered for cache efficiency:
#   1. apt layer        — system libs (changes ~never)
#   2. dependency layer — keyed on pyproject.toml + uv.lock only
#   3. source layer     — code/tests copied last; only the project itself reinstalls
#
# Build:  docker build -f Dockerfile.test -t moeka-test .
# Run:    docker run --rm moeka-test                          # full suite
#         docker run --rm moeka-test pytest tests/agent -v    # subset
# (or use scripts/test-docker.sh, which does both.)
#
# The `vec` extra (sentence-transformers -> CUDA torch, multiple GB) is excluded
# by default; the vec tests importorskip. For full CI parity build with:
#         docker build -f Dockerfile.test --build-arg NO_EXTRA= -t moeka-test .

FROM python:3.13-slim

# System deps mirror .github/workflows/ci.yml: libolm for matrix-nio[e2e],
# build-essential for native wheels (cffi/python-olm). git is shelled out to
# by tests/utils/test_gitstore.py.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libolm-dev git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# --- dependency layer: invalidated only when the manifests change ------------
# --no-install-project defers installing moeka itself to the source layer, so
# code edits never re-resolve dependencies. The cache mount keeps downloaded
# wheels across builds even when this layer is invalidated.
ARG NO_EXTRA="vec"
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --all-extras ${NO_EXTRA:+--no-extra ${NO_EXTRA}} --no-install-project

# --- source layer: code last so edits only rebuild from here -----------------
# scripts/ is imported directly by tests/channels/test_channel_plugins.py
# (as `scripts.install_channel_dependencies`), not just shelled out to.
# conftest.py (root) carries cross-suite infrastructure that must be active
# for *every* test tree, not just tests/: the $HOME redirect + mkdir guard
# that makes it structurally impossible for a leaking test to touch the real
# ~/.nanobot, and _isolate_sessions_root, which keeps ADR-0001's "session
# storage must be outside the workspace" invariant from firing on tests that
# never intended to test it. Omitting this file silently disabled both for
# every Docker run until the 2026-09-17 incident review caught it -- see
# .agent/upstream-sync-notes.md's incident writeup.
COPY conftest.py ./
COPY README.md LICENSE THIRD_PARTY_NOTICES.md hatch_build.py ./
COPY nanobot/ nanobot/
COPY moeka/ moeka/
COPY scripts/ scripts/
# tests/examples runs examples/*.py and the quick start in docs/python-sdk.md.
COPY examples/ examples/
COPY docs/python-sdk.md docs/python-sdk.md
COPY schemas/ schemas/
COPY tests/ tests/
# webui/ itself is git-ignored here (Python tests don't need the frontend
# source), but tests/utils/test_webui_event_projection_equivalence.py reads
# this one fixture directly to cross-check Python/TS event-projection parity.
COPY webui/src/tests/fixtures/live-replay-event-projection.json webui/src/tests/fixtures/live-replay-event-projection.json
# tests/webui/test_settings_runtime.py reads this one frontend source file
# directly to cross-check that every runtime setting the backend exposes has
# a matching frontend editor field.
COPY webui/src/components/settings/system/runtime-config-fields.ts webui/src/components/settings/system/runtime-config-fields.ts
# packages/ and tui/ are TS/Bun sources, not Python packages, but
# tests/webui/test_notification_contract.py reads packages/client-events/
# fixtures.json directly and exec's tui/scripts/package-release.py as a
# module to check its source archive step -- both need the real trees on
# disk, not just their Python-relevant fixture files.
COPY packages/ packages/
COPY tui/ tui/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --all-extras ${NO_EXTRA:+--no-extra ${NO_EXTRA}}

# Channel manifest dependencies (e.g. matrix-nio, mistune, nh3 for Matrix) live
# outside pyproject.toml's extras -- installed on demand via `nanobot plugins
# enable <name>`. Mirrors .github/workflows/ci.yml's "Install channel
# dependencies" step so tests that load every discovered channel's runtime
# class (e.g. tests/channels/test_channel_setup.py) don't fail on a missing
# optional plugin dependency.
#
# linkpreview (a transitive dependency pulled in by this step) ships a
# top-level `tests/` package in its sdist (a packaging bug upstream of us --
# it's missing `packages=find_packages(exclude=["tests"])`). Because our own
# tests/ has no __init__.py (a namespace package, by design -- see
# tests/agent/*'s bare `from agent.x import y` imports, which rely on
# pytest's conftest-driven sys.path insertion, not a regular top-level
# `tests` package), Python's import system prefers linkpreview's *regular*
# site-packages `tests` package over our namespace one the moment both are on
# sys.path, silently breaking every `from tests.x import y` (including
# conftest.py's own real-$HOME guard). Strip the stray package rather than
# adding tests/__init__.py, which would change pytest's rootdir-insertion
# behavior for the whole suite.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv run --no-sync python -m scripts.install_channel_dependencies --all-channels \
    && rm -rf /opt/venv/lib/python3.*/site-packages/tests

ENTRYPOINT ["uv", "run", "--no-sync"]
# Match pyproject.toml's [tool.pytest.ini_options] testpaths (tests/ plus
# nanobot/channels/, which carries its own per-channel tests/ subpackages,
# e.g. nanobot/channels/websocket/tests/) -- a bare "pytest tests/" here
# silently skipped that whole tree.
CMD ["pytest", "tests/", "nanobot/channels/"]
