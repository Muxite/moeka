# Keep the build context minimal so source-layer cache keys are stable.
.git
.venv
.worktrees
.worktree
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc

# Secrets — never ship into an image
keys.env
keys.env.example
.env

# Frontend (not needed for Python tests) — except the one fixture
# tests/utils/test_webui_event_projection_equivalence.py cross-checks
# Python/TS event-projection parity against.
webui
!webui/src/tests/fixtures/live-replay-event-projection.json

# Local runtime artifacts
nohup.out
*.log
images
docs
media
.assets
.docs
