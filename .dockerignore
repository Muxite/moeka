# Keep the build context minimal so source-layer cache keys are stable.
.git
.venv
.worktrees
.worktree
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc

# Secrets — never ship into an image
keys.env
keys.env.example
.env

# Frontend (not needed for Python tests) — except the fixtures/source files
# specific Python tests cross-check against:
# - tests/utils/test_webui_event_projection_equivalence.py (Python/TS
#   event-projection parity)
# - tests/webui/test_settings_runtime.py (every runtime setting has a
#   frontend editor field)
webui
!webui/src/tests/fixtures/live-replay-event-projection.json
!webui/src/components/settings/system/runtime-config-fields.ts

# Local runtime artifacts
nohup.out
*.log
images
docs
# ... except the SDK page whose quick start tests/examples executes.
!docs/python-sdk.md
# ... and the spec 005 pages checked by tests/docs.
!docs/deployment.md
!docs/multiple-instances.md
media
.assets
.docs

# compose secrets
moeka.env
